#!/bin/sh
# Postfix pipe hook. The analyzer itself stays in the image.
set -eu

IMAGE="${DMARC_ANALYZER_IMAGE:-dmarc-analyzer}"
ENV_FILE="${DMARC_ANALYZER_ENV:-/etc/dmarc/analyzer.env}"

if [ -f "$ENV_FILE" ]; then
  exec docker run \
    --rm -i \
    --network host \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --init \
    --tmpfs /tmp:rw,noexec,nosuid,size=16m \
    --env-file "$ENV_FILE" \
    "$IMAGE" "$@"
fi

exec docker run \
  --rm -i \
  --network host \
  --read-only \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --init \
  --tmpfs /tmp:rw,noexec,nosuid,size=16m \
  "$IMAGE" "$@"

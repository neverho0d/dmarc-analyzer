# Default profile. Unprefixed keys apply to every profile unless a PROFILE_*
# entry overrides them.
#
# The viewer and the mail pipe pick a profile automatically from
# <policy_published><domain> in the DMARC report (exact match, then longest
# parent domain). header_from is not used for that choice.

# Domains this default profile owns (comma-separated)
TARGET_DOMAINS=example.com

# Authorized outbound mail servers (CIDR or bare host; hosts are /32 or /128)
AUTHORIZED_SERVER_NETS=95.217.200.86/32,127.0.0.1,2001:db8::86

# true: list authorized senders, and unauthorized (spam) rows only when the
# published DMARC policy is still weak (not p=quarantine/reject). false: list
# every row. You cannot make spoofers pass SPF/DKIM; tightening DMARC is what
# stops that mail.
REPORT_AUTHORIZED_ONLY=true

# DKIM selectors to probe when a report omits them
FALLBACK_DKIM_SELECTORS=default,s1,srs,mail

# Used for alert mail and as the rua= address in a recommended DMARC record
ALERT_EMAIL_TO=postmaster@example.com
ALERT_EMAIL_FROM=dmarc-analyzer@example.com

# Pipe dispatch: smtp (container) or sendmail (host MTA)
DISPATCH_METHOD=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=25

# Additional profile. Repeat PROFILE_<name>_KEY for each domain you manage.
# Unlisted keys inherit from the default profile above.
PROFILE_4JOB_TARGET_DOMAINS=4job.co
PROFILE_4JOB_AUTHORIZED_SERVER_NETS=120.138.18.240/28
PROFILE_4JOB_ALERT_EMAIL_TO=postmaster@4job.co
PROFILE_4JOB_ALERT_EMAIL_FROM=dmarc-analyzer@4job.co
